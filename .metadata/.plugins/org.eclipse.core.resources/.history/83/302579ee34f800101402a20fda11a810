#include "tasks.h"

uint8_t led_enabled = 1;
TaskHandle_t xCpu1SignalTaskHandle = NULL;

void Init_tasks (void)
{
	xTaskCreate(vTaskPrint,  "TaskPrint",  configMINIMAL_STACK_SIZE + 100, NULL, 1, NULL);
	xTaskCreate(vTaskBlink,  "TaskBlink",  configMINIMAL_STACK_SIZE + 100, NULL, 2, NULL);
	xTaskCreate(vTaskUartRx, "TaskUartRx", configMINIMAL_STACK_SIZE + 100, NULL, 3, NULL);

	// Новая задача — ждёт сигнал от CPU1
	xTaskCreate(vTaskFromCpu1, "TaskFromCPU1", configMINIMAL_STACK_SIZE + 200, NULL, 4, &xCpu1SignalTaskHandle);
}

void vTaskPrint(void *pvParameters)
{
    (void) pvParameters;
    while(1)
    {
        xil_printf("LED %s\r\n", led_enabled ? "TRUE" : "FALSE");
        vTaskDelay(pdMS_TO_TICKS(2000));
    }
}


void vTaskFromCpu1(void *pvParameters)
{
    for(;;)
    {
        // Ждём уведомления (приходит из IPI handler)
        ulTaskNotifyTake(pdTRUE, portMAX_DELAY);

        // Действие по сигналу ядра 1
        xil_printf("CPU0: got signal from CPU1!\n");
    }
}


void vTaskBlink(void *pvParameters)
{
    (void) pvParameters;
    uint8_t led_state = 0;
    uint8_t flag = 0;

    while(1)
    {
        if (led_enabled)
        {
            led_state = !led_state;
            XGpioPs_WritePin(&Gpio, LED_PIN_M, led_state);
            XGpioPs_WritePin(&Gpio, LED_PIN_R, !led_state);
        }
        else
        {
            XGpioPs_WritePin(&Gpio, LED_PIN_M, 0);
            XGpioPs_WritePin(&Gpio, LED_PIN_R, 1);
        }

        vTaskDelay(pdMS_TO_TICKS(500));
    }
}

void vTaskUartRx(void *pvParameters)
{
    (void) pvParameters;
    u8 ch;

    while(1)
    {
        if (XUartPs_IsReceiveData(Uart.Config.BaseAddress))
        {
            ch = XUartPs_ReadReg(Uart.Config.BaseAddress, XUARTPS_FIFO_OFFSET);
            if (ch == '1')
            {
                led_enabled = 1;
                xil_printf("LED TRUE\r\n");
            }
            else if (ch == '0')
            {
                led_enabled = 0;
                xil_printf("LED False\r\n");
            }
            else
            {
                xil_printf("dnkw\r\n", ch);
            }
        }
        vTaskDelay(pdMS_TO_TICKS(50));
    }
}

