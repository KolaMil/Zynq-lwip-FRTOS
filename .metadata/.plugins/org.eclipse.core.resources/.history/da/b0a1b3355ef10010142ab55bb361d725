#include "main.h"

int main(void)
{
	start_cpu1();
	xil_printf("\nHello bratish! I'm CPU0\r\n");
	xTaskCreate(network_init_task, "Network Init", THREAD_STACKSIZE, NULL, tskIDLE_PRIORITY + 3, NULL);
	vTaskStartScheduler();

	while(1);
}

/*-----------------------------------------------------------*/
static void network_init_task(void *pvParameters)
{
	const TickType_t x1second = pdMS_TO_TICKS(DELAY_1_SECOND);

	// 1. Создаем семафор ОБЯЗАТЕЛЬНО до запуска задач
	data_done_sem = xSemaphoreCreateBinary();
	if (data_done_sem == NULL) {
		xil_printf("Error: Could not create semaphore\r\n");
		vTaskDelete(NULL);
		return;
	}
	while(1)
	{
		vTaskDelay(x1second);
		lwip_network_setup();
		xTaskCreate((TaskFunction_t)x1emacif_input_thread, "xemacif_input", THREAD_STACKSIZE, &server_netif, UDP_TASK_PRIO, NULL);
		udp_connection();
		tsp_connection_cl();
		xTaskCreate(udp_send_task, "UDP Task", THREAD_STACKSIZE, NULL, UDP_TASK_PRIO, NULL);
//		xTaskCreate(semaphore_generator_task, "SemGen", THREAD_STACKSIZE, NULL, UDP_TASK_PRIO + 1, NULL);
		vTaskDelete(NULL);
	}
}

/*-----------------------------------------------------------*/
void udp_send_task(void *arg)
{
    // 1. Выделяем pbuf один раз перед циклом
    // Важно: используем PBUF_RAM, чтобы payload был гарантированно доступен для записи
    struct pbuf *p = pbuf_alloc(PBUF_TRANSPORT, sizeof(data_imit_dma) + 1, PBUF_RAM);
    if (p == NULL) {
        xil_printf("Failed to alloc pbuf\r\n");
        vTaskDelete(NULL);
        return;
    }

    // Предварительно копируем основной массив данных в pbuf
    memcpy(p->payload, data_imit_dma, sizeof(data_imit_dma));

    // 2. Настройка периодичности
    TickType_t xLastWakeTime = xTaskGetTickCount();
    const TickType_t xPeriod = pdMS_TO_TICKS(2); // Период 2 мс
    uint8_t i = 0;

    xil_printf("UDP periodic task started (2ms period)\r\n");

    while(1)
    {
        // Ждем ровно 2 мс с момента последнего просыпания
        vTaskDelayUntil(&xLastWakeTime, xPeriod);

        // Обновляем изменяющийся байт в конце payload
        ((uint8_t*)p->payload)[sizeof(data_imit_dma)] = '0' + i;

        // Отправляем пакет
        if(udp_send(udp_pcb_conn, p) != ERR_OK) {
            // Ошибка может быть, если сеть перегружена
            // xil_printf("E");
        }

        // Логика счетчика
        i++;
        if(i > 9) i = 0;
    }

    // На случай выхода из цикла (хотя здесь он бесконечный)
    pbuf_free(p);
    vTaskDelete(NULL);
}

