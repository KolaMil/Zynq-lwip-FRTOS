#include "main.h"

static XGpioPs  XGpioPsInstance;  // This is our EMIO instance
XGpioPs_Config* GpioConfigPtr;
int             xStatus;

int main(void)
{
	start_cpu1();
	init_platform();
	xil_printf("\nHello bratish! I'm CPU0\r\n");
	xTaskCreate(network_init_task, "Network Init", THREAD_STACKSIZE, NULL, tskIDLE_PRIORITY + 3, NULL);

	GpioConfigPtr = XGpioPs_LookupConfig(XPAR_PS7_GPIO_0_DEVICE_ID);
	if(GpioConfigPtr == NULL)
		return XST_FAILURE;

	xStatus = XGpioPs_CfgInitialize(&XGpioPsInstance,GpioConfigPtr, GpioConfigPtr->BaseAddr);
	if(XST_SUCCESS != xStatus)
		print(" PS GPIO INIT FAILED \n\r");

	xil_printf("EMIO driver initialized");

	XGpioPs_SetDirectionPin(&XGpioPsInstance, 54,1);
	XGpioPs_SetDirectionPin(&XGpioPsInstance, 55,1);
	XGpioPs_SetDirectionPin(&XGpioPsInstance, 56,1);
	XGpioPs_SetDirectionPin(&XGpioPsInstance, 57,1);

	XGpioPs_SetDirectionPin(&XGpioPsInstance, 58,0);

	XGpioPs_SetOutputEnablePin(&XGpioPsInstance, 54,1);
	XGpioPs_SetOutputEnablePin(&XGpioPsInstance, 55,1);
	XGpioPs_SetOutputEnablePin(&XGpioPsInstance, 56,1);
	XGpioPs_SetOutputEnablePin(&XGpioPsInstance, 57,1);
	XGpioPs_SetOutputEnablePin(&XGpioPsInstance, 58,1);
//	XGpioPs_SetDirectionPin(&psGpioInstancePtr, 55,1);
	vTaskStartScheduler();

	while(1);
}

/*-----------------------------------------------------------*/
static void network_init_task(void *pvParameters)
{
	const TickType_t x1second = pdMS_TO_TICKS(DELAY_1_SECOND);

	data_done_sem = xSemaphoreCreateBinary();
	if (data_done_sem == NULL) {
		xil_printf("Error: Could not create semaphore\r\n");
		vTaskDelete(NULL);
		return;
	}
	while(1)
	{
		vTaskDelay(x1second);
		lwip_network_setup();
		xTaskCreate((TaskFunction_t)x1emacif_input_thread, "xemacif_input", THREAD_STACKSIZE, &server_netif, UDP_TASK_PRIO, NULL);
		udp_connection();
		tcp_connection_cl();
		xTaskCreate(udp_send_task, "UDP Task", THREAD_STACKSIZE, NULL, UDP_TASK_PRIO,  &xIrqTaskHandle);
		vInitialiseTimer();
		vTaskDelete(NULL);
	}
}

