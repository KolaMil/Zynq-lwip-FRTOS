#include "main.h"

int main(void)
{
	start_cpu1();
	init_platform();
	xil_printf("\nHello bratish! I'm CPU0\r\n");
	xTaskCreate(network_init_task, "Network Init", THREAD_STACKSIZE, NULL, tskIDLE_PRIORITY + 3, NULL);
	xTaskCreate(vStatsTask, "StatsTask", THREAD_STACKSIZE, NULL, tskIDLE_PRIORITY, NULL);
	vTaskStartScheduler();

	while(1);
}

/*-----------------------------------------------------------*/
static void network_init_task(void *pvParameters)
{
	const TickType_t x1second = pdMS_TO_TICKS(DELAY_1_SECOND);
	while(1)
	{
		vTaskDelay(x1second);
		lwip_network_setup();
		xTaskCreate((TaskFunction_t)x1emacif_input_thread, "xemacif_input", THREAD_STACKSIZE, &server_netif, UDP_TASK_PRIO, NULL);
		udp_connection(default_state, sizeof(default_state));
		tcp_connection_cl();
		xTaskCreate(udp_send_task, "UDP Task", THREAD_STACKSIZE, NULL, UDP_TASK_PRIO,  &xIrqTaskHandle);
		vInitialiseTimer();
		vTaskDelete(NULL);
	}
}

/*-----------------------------------------------------------*/
void udp_send_task(void *arg)
{
	struct pbuf *p = pbuf_alloc(PBUF_TRANSPORT, sizeof(data_imit_dma) + 1, PBUF_POOL);
	if (p == NULL)
	{
		xil_printf("Failed to alloc pbuf\r\n");
		vTaskDelete(NULL);
	}
	p->payload = (void *)data_imit_dma;
	memcpy(p->payload, data_imit_dma, sizeof(data_imit_dma));
	uint8_t i = 0;
    xil_printf("UDP task started (simple delay 2ms)\r\n");
    u8 flag = 0;
    uint16_t counter = 0;
    uint32_t average = 0;

    while(1)
    {
		ulTaskNotifyTake( pdTRUE, portMAX_DELAY );
		flag ^= 1;
		vParTestSetGPIO(IO_L24N_T3_12, flag);
		start_stop_ttc_timer(TTC_TIMER_CHANNEL_2, 1);
		((uint8_t*)p->payload)[21] = '0' + i;
		if(udp_send(udp_pcb_conn, p) != ERR_OK)
		{
			xil_printf("Error sending UDP packet\r\n");
		}
		start_stop_ttc_timer(TTC_TIMER_CHANNEL_2, 0);
		counter = get_ttc_counter_value(TTC_TIMER_CHANNEL_2);
		average = (average + counter) / 2;
		vParTestSetGPIO(IO_L23P_T3_12, flag);
		i++;
		if(i > 9)
		{
			i = 0;
		}
    }
}

void vStatsTask(void *arg)
{
    const TickType_t xPeriod = pdMS_TO_TICKS(5000);

    while(1)
    {
        vTaskDelay(xPeriod);

    }
}


/*-----------------------------------------------------------*/
void x1emacif_input_thread(void *arg)
{
    struct netif *netif = (struct netif *)arg;
    while(1)
    {
        xemacif_input(netif); /* из xadapter.h */
        vTaskDelay(pdMS_TO_TICKS(1));
    }
}
